# Maintainer: UFLinux contributors <noreply@example.invalid>
pkgname=llvm22-bolt
pkgver=22.1.3
pkgrel=0
pkgdesc="LLVM BOLT post-link optimizer and instrumentation runtime"
url="https://llvm.org"
arch="x86_64 aarch64"
license="Apache-2.0 WITH LLVM-exception"
makedepends="clang22 cmake samurai llvm22-dev llvm22-static llvm22-gtest zlib-dev zstd-dev libxml2-dev"
# The upstream lit suite needs a full LLVM source/build tree. Exercise the tools
# here; the consumer also trains and runs a real instrumented GUI executable.
source="https://github.com/llvm/llvm-project/releases/download/llvmorg-$pkgver/llvm-project-$pkgver.src.tar.xz"
builddir="$srcdir/llvm-project-$pkgver.src"

build() {
	cmake -S bolt -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_COMPILER=clang-22 \
		-DCMAKE_CXX_COMPILER=clang++-22 \
		-DCMAKE_INSTALL_PREFIX=/usr/lib/llvm22 \
		-DLLVM_DIR=/usr/lib/llvm22/lib/cmake/llvm \
		-DBOLT_TARGETS_TO_BUILD="X86;AArch64" \
		-DBOLT_ENABLE_RUNTIME=ON \
		-DLLVM_INCLUDE_TESTS=OFF
	cmake --build build --parallel "${JOBS:-2}" --target llvm-bolt merge-fdata
}
check() {
	build/bin/llvm-bolt --version
	build/bin/merge-fdata --help
	test -s build/bolt_rt-bins/lib/libbolt_rt_instr.a
}
package() {
	install -Dm755 build/bin/llvm-bolt "$pkgdir/usr/lib/llvm22/bin/llvm-bolt"
	install -Dm755 build/bin/merge-fdata "$pkgdir/usr/lib/llvm22/bin/merge-fdata"
	install -Dm644 build/bolt_rt-bins/lib/libbolt_rt_instr.a "$pkgdir/usr/lib/llvm22/lib/libbolt_rt_instr.a"
	install -Dm644 build/bolt_rt-bins/lib/libbolt_rt_hugify.a "$pkgdir/usr/lib/llvm22/lib/libbolt_rt_hugify.a"
	mkdir -p "$pkgdir/usr/bin"
	ln -s ../lib/llvm22/bin/llvm-bolt "$pkgdir/usr/bin/llvm-bolt"
	ln -s ../lib/llvm22/bin/merge-fdata "$pkgdir/usr/bin/merge-fdata"
}
sha512sums="
3557a955d55471671ae2f7b9c809affd59a29a6fb1e70a2a5d040dc1c6376246deb0635be8ca36cae09112981760e9afb128c822e5554bd722589fb8dee3f0df  llvm-project-22.1.3.src.tar.xz
"
